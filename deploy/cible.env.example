# Copier en deploy/<cible>.env (ignoré par git) puis : hack/deploy.sh <cible>
KUBE_CONTEXT=mon-contexte
# Cluster derrière ce contexte (kubectl config get-contexts) : le script refuse
# de déployer si le contexte pointe ailleurs.
EXPECTED_CLUSTER=gke_mon-projet_europe-west1_mon-cluster
IMAGE=registry.example.com/cluster-atlas
VALUES=deploy/values.<cible>.yaml
